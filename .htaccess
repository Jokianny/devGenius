# ==============================================================================
# DEVGENIUS ACADEMY - APACHE SHARED HOSTING .htaccess
# Fully compatible with: cPanel (EasyApache / LiteSpeed) & DirectAdmin (CustomBuild)
# Apache 2.4+ & 2.2 compatible | PHP-FPM & mod_php safe
# ==============================================================================

# 1. Prevent Directory Browsing & Force PHP as Primary Entry Point
Options -Indexes
DirectoryIndex index.php index.html

# 2. Symlinks compatibility & PHP routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If someone accesses index.html directly on Apache, redirect to index.php
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
    RewriteRule ^index\.html$ index.php [R=301,L]

    # Redirect trailing slashes if not a directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Ensure UTF-8 default
    AddDefaultCharset UTF-8
</IfModule>

# 3. Protect sensitive files (Dual Apache 2.4 and Apache 2.2 syntax)
<FilesMatch "^(config\.php|\.env|\.git|database\.sql|composer\.json|package\.json|\.user\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Security Headers (Only if mod_headers is available, avoids 500 on stripped hosts)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. PHP INI directives (Wrapped in mod_php to prevent 500 error on PHP-FPM servers)
# Note: For PHP-FPM (standard in DirectAdmin & modern cPanel), settings are in .user.ini
<IfModule mod_php.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
    php_value max_execution_time 300
    php_value session.cookie_httponly 1
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
    php_value max_execution_time 300
    php_value session.cookie_httponly 1
</IfModule>
