# Deny execution of scripts in uploads/ directory
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|cgi|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
